digraph RaceDayERD {
  graph [rankdir=TB, bgcolor="white", pad=0.4, nodesep=0.75, ranksep=0.9, splines=polyline, fontname="Arial"];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=12, fontcolor="#172033", color="#334155", penwidth=1.8, arrowsize=0.85];

  Users [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#263a8b"><FONT COLOR="white"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> UserId : INT</TD></TR><TR><TD ALIGN="LEFT">FirstName : NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">LastName : NVARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT">Email : NVARCHAR(255) UNIQUE</TD></TR><TR><TD ALIGN="LEFT">PasswordHash : NVARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">Role : Organiser | Participant</TD></TR><TR><TD ALIGN="LEFT">Phone : NVARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">CreatedAt : DATETIME2</TD></TR></TABLE>>];
  Events [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7048e8"><FONT COLOR="white"><B>Events</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> EventId : INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> OrganiserId : INT</TD></TR><TR><TD ALIGN="LEFT">Name : NVARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">Description : NVARCHAR(500)</TD></TR><TR><TD ALIGN="LEFT">Venue : NVARCHAR(200)</TD></TR><TR><TD ALIGN="LEFT">EventDate : DATE</TD></TR><TR><TD ALIGN="LEFT">RegistrationOpen : DATE</TD></TR><TR><TD ALIGN="LEFT">RegistrationClose : DATE</TD></TR><TR><TD ALIGN="LEFT">Status : NVARCHAR(20)</TD></TR></TABLE>>];
  Categories [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0f9d8a"><FONT COLOR="white"><B>Categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> CategoryId : INT</TD></TR><TR><TD ALIGN="LEFT">Name : NVARCHAR(100) UNIQUE</TD></TR><TR><TD ALIGN="LEFT">DistanceKm : DECIMAL(6,2)</TD></TR><TR><TD ALIGN="LEFT">MaxParticipants : INT</TD></TR></TABLE>>];
  UserProfiles [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#f08c46"><FONT COLOR="white"><B>UserProfiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> ProfileId : INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> UserId : INT UNIQUE</TD></TR><TR><TD ALIGN="LEFT">DateOfBirth : DATE</TD></TR><TR><TD ALIGN="LEFT">Gender : NVARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">EmergencyContactName : NVARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">EmergencyContactPhone : NVARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">Address : NVARCHAR(300)</TD></TR></TABLE>>];
  EventCategories [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#d94f8a"><FONT COLOR="white"><B>EventCategories</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> EventId : INT</TD></TR><TR><TD ALIGN="LEFT"><B>PK/FK</B> CategoryId : INT</TD></TR><TR><TD ALIGN="LEFT">EntryFee : DECIMAL(10,2)</TD></TR></TABLE>>];
  Enrolments [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#4c78a8"><FONT COLOR="white"><B>Enrolments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> EnrolmentId : INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> ParticipantId : INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> EventId : INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> CategoryId : INT</TD></TR><TR><TD ALIGN="LEFT">EnrolmentDate : DATETIME2</TD></TR><TR><TD ALIGN="LEFT">Status : NVARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">RaceNumber : INT</TD></TR></TABLE>>];
  Results [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7a5c3e"><FONT COLOR="white"><B>Results</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> ResultId : INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> EnrolmentId : INT UNIQUE</TD></TR><TR><TD ALIGN="LEFT">FinishTime : TIME</TD></TR><TR><TD ALIGN="LEFT">Position : INT</TD></TR><TR><TD ALIGN="LEFT">ResultStatus : NVARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">RecordedAt : DATETIME2</TD></TR></TABLE>>];

  { rank=same; UserProfiles; Users; Events; }
  { rank=same; Enrolments; EventCategories; Categories; }
  { rank=same; Results; }

  /* Fix left-to-right order within each row so real edges route without crossing */
  UserProfiles -> Users [style=invis, weight=10];
  Enrolments -> EventCategories [style=invis, weight=10];
  EventCategories -> Categories [style=invis, weight=10];

  /* Real, labelled relationships - forms a clean rectangle: Users-Events-EventCategories-Enrolments-Users */
  Users -> UserProfiles [label="1 : 0..1\nhas profile"];
  Users -> Events [label="1 : many\norganises"];
  Users -> Enrolments [label="1 : many\nparticipates"];
  Events -> EventCategories [label="1 : many"];
  Categories -> EventCategories [label="1 : many"];
  EventCategories -> Enrolments [label="1 : many"];
  Enrolments -> Results [label="1 : 0..1"];
}
